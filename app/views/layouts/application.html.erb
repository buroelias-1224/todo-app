<!DOCTYPE html>
<html>
  <head>
    <title>TodoApp</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body class="bg-gray-100">
    <header class="bg-white shadow">
      <div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center">
          <h1 class="text-3xl font-bold text-gray-900">
            <%= @greeting %> Todo App
          </h1>
          <div class="visit-info bg-gray-100 p-4 rounded-lg">
            <p class="text-sm text-gray-600">Last visited: <%= @time_since_last_visit %> ago</p>
            <p class="text-sm text-gray-600">Total visits: <%= session[:total_visits] %></p>
            <p class="text-sm text-gray-600">Page visits: <%= session[:page_visits][request.path] %></p>
          </div>
        </div>
      </div>
    </header>

    <main class="container mx-auto px-4 py-6">
      <%= yield %>
    </main>
  </body>
</html>