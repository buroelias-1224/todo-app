<div class="container mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-6">Tasks</h1>

  <%= link_to 'New Task', new_todo_path, class: 'btn btn-primary mb-6' %>

  <div class="bg-white shadow rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Title</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @todos.each do |todo| %>
          <tr class="<%= todo.completed ? 'bg-gray-50' : '' %>">
            <td class="px-6 py-4 whitespace-nowrap <%= 'line-through text-gray-400' if todo.completed %>">
              <%= todo.title %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <%= form_with model: todo, url: toggle_complete_todo_path(todo), method: :patch, local: true do |f| %>
                <%= f.check_box :completed, 
                      checked: todo.completed, 
                      onchange: 'this.form.submit();',
                      class: 'h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded' %>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
              <%= link_to 'Edit', edit_todo_path(todo), class: 'text-blue-600 hover:text-blue-900 mr-3' %>
              <%= link_to 'Delete', todo, method: :delete, 
                    data: { confirm: 'Are you sure?' },
                    class: 'text-red-600 hover:text-red-900' %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>